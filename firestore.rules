rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to reflections collection
    match /reflections/{signalId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to responses collection
    match /responses/{responseId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to explorers collection
    match /explorers/{explorerId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to relationships collection
    match /relationships/{relationshipId} {
      allow read, write: if request.auth != null;
    }

    // Allow any logged-in user to read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-Explorer notification tuning. Clients may read; backend owns writes.
    match /system_config/{explorerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App-wide Connect copy (What's New / system message). Publish via Console;
    // clients read only — bump `version` when you update the body.
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Server-side notification staging. Clients must not access.
    match /pending_notifications/{notificationId} {
      allow read, write: if false;
    }
  }
}
